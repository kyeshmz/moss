# Copy to .env in the repository root. All values stay in the local service.
# HEX_BIN=/Applications/Hex.app/Contents/MacOS/hex
HEX_MODEL=parakeet_unified_en
HEX_LANGUAGE=en
# MOSS_DATA_DIR=/absolute/path/to/private/meeting-data
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# Optional AI summaries, using an OpenAI-compatible server (local by default).
# SUMMARY_BASE_URL=http://127.0.0.1:11434/v1
# SUMMARY_MODEL=your-installed-model
# SUMMARY_API_KEY=
# For a remote endpoint, explicitly consent to sending notes/transcripts:
# SUMMARY_ALLOW_REMOTE=true
# Optional OpenCode project directory for agent/model discovery. Defaults to the service working directory.
# MOSS_OPENCODE_DIRECTORY=/absolute/path/to/granola-alternative
